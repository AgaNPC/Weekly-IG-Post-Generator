{
  "name": "Weekly IG Post Generator - Property News Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1
            }
          ]
        }
      },
      "name": "Weekly Cron Trigger (Every Monday 08:00 AM)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://newsapi.org/v2/everything?q=properti+OR+KPR+OR+rumah&language=id&sortBy=publishedAt",
        "options": {}
      },
      "name": "Fetch Latest Property News RSS/API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a professional social media manager for a Real Estate brand. Convert the provided property news into a 4-slide Instagram Carousel structure and copy caption."
            },
            {
              "role": "user",
              "content": "News Title: {{$json.title}}\nSummary: {{$json.description}}"
            }
          ]
        }
      },
      "name": "AI IG Post & Caption Generator (LLM)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "name": "Output to Dashboard Webhook / IG Scheduler",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Weekly Cron Trigger (Every Monday 08:00 AM)": {
      "main": [
        [
          {
            "node": "Fetch Latest Property News RSS/API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Latest Property News RSS/API": {
      "main": [
        [
          {
            "node": "AI IG Post & Caption Generator (LLM)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI IG Post & Caption Generator (LLM)": {
      "main": [
        [
          {
            "node": "Output to Dashboard Webhook / IG Scheduler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
